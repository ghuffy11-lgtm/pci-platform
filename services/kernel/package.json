{
  "name": "@pci/kernel",
  "version": "0.1.0",
  "private": true,
  "description": "PCI Platform Kernel — Knowledge Objects, relationships, provenance, audit, tenancy (WP-0001)",
  "license": "SEE LICENSE IN ../../docs/product/licensing-and-open-source-policy.md",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:contract",
    "test:unit": "node --test 'test/unit/**/*.test.ts'",
    "test:contract": "node --test 'test/contract/**/*.test.ts'",
    "test:integration": "node --test 'test/integration/**/*.test.ts'",
    "test:all": "npm run test:unit && npm run test:contract && npm run test:integration",
    "migrate": "node src/cli/migrate.ts"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "typescript": "5.9.3"
  }
}
