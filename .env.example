# PCI kernel - development environment template
#
# Copy to .env and replace every REPLACE_ME value. .env is gitignored (ADR-0009).
#
#     cp .env.example .env
#
# NOTHING IN THIS FILE IS A REAL CREDENTIAL. Every value below is a placeholder and is
# rejected at startup: the kernel refuses to run with a token shorter than 16 characters,
# and the database refuses to initialise with an app password shorter than 16.
#
# Generate real values locally. On Linux or macOS:
#
#     openssl rand -base64 24        # for the two passwords
#     openssl rand -hex 24           # for the principal token
#
# Generate them ON THE MACHINE THAT WILL USE THEM and never paste them into a terminal you
# do not control, a commit, an issue, or a chat message.

# --------------------------------------------------------------------- database
# Superuser, used only by initdb and the migration service.
POSTGRES_DB=pci
POSTGRES_SUPERUSER=pci_admin
POSTGRES_SUPERUSER_PASSWORD=REPLACE_ME_superuser_password

# Least-privilege runtime role. Supplied to initdb via PGOPTIONS so that
# deploy/compose/initdb/00-roles.sql can create pci_app with a password
# (NOSUPERUSER, NOBYPASSRLS - ADR-0016 depends on both).
PCI_APP_PASSWORD=REPLACE_ME_app_password

# --------------------------------------------------------------------- identity
# Development principals for the static identity adapter.
#
# The static adapter is a DEVELOPMENT FIXTURE and is prohibited in production
# (ADR-0007, SPEC-0004, DISC-0003). The kernel logs a warning at startup whenever it is
# active, and its production guard refuses to start with it.
#
# The service is fail-closed: PCI_IDENTITY_MODE=static with no principals refuses to start
# rather than serving unauthenticated requests. That guard is deliberate. Supply a principal
# here - do not weaken the guard to make the stack come up (DISC-0008).
#
# Format: JSON array. Required fields: token (>= 16 chars), subject, tenantId (slug),
# actorType (human | service | agent). Optional: roles, scopes, displayName, delegatedBy.
#
# The token below is a PLACEHOLDER and will not authenticate anything. Replace it with a
# generated value.
PCI_STATIC_PRINCIPALS=[{"token":"REPLACE_ME_with_openssl_rand_hex_24","subject":"dev-operator","tenantId":"acme","actorType":"service","roles":["admin"]}]

# --------------------------------------------------------------------- service
PCI_ENVIRONMENT=development
PCI_IDENTITY_MODE=static
PCI_LOG_LEVEL=info
PCI_PORT=8080
