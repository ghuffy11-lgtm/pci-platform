# PCI Kernel — example environment
#
# Copy to `.env` and replace every value. `.env` is git-ignored.
#
# ⚠ EVERY VALUE BELOW IS A SYNTHETIC PLACEHOLDER, NOT A CREDENTIAL.
#   docs/security/security-architecture.md:39 requires development fixtures to use synthetic
#   credentials. ADR-0009 forbids real secrets in Git. Nothing here is or has ever been a real
#   secret, and none of these values may be used in any shared or production environment.

# ---------------------------------------------------------------- environment
PCI_ENV=development
PCI_LOG_LEVEL=info

# ------------------------------------------------------------------ database
POSTGRES_DB=pci
POSTGRES_SUPERUSER=pci_admin

# Owner/migration role password. REPLACE THIS.
POSTGRES_SUPERUSER_PASSWORD=replace-me-local-only-0000

# Least-privilege runtime role password. REPLACE THIS.
# This role must not hold SUPERUSER or BYPASSRLS — see deploy/compose/initdb/00-roles.sql.
PCI_APP_PASSWORD=replace-me-local-only-1111

# ------------------------------------------------------------------ identity
# 'static' is a DEVELOPMENT-ONLY adapter. The kernel refuses to start with
# PCI_IDENTITY_MODE=static when PCI_ENV=production (ADR-0007, SPEC-0004, DISC-0003).
PCI_IDENTITY_MODE=static

# Development principals. Tokens are opaque synthetic bearer strings — never passwords.
# Roles: platform_admin | knowledge_author | knowledge_reader | knowledge_steward | security_officer
PCI_STATIC_PRINCIPALS=[{"token":"dev-author-token-replace-me-0001","subject":"user:author","tenantId":"tenant-alpha","actorType":"human","displayName":"Dev Author","roles":["knowledge_author","knowledge_reader"]},{"token":"dev-steward-token-replace-me-002","subject":"user:steward","tenantId":"tenant-alpha","actorType":"human","displayName":"Dev Steward","roles":["knowledge_steward","knowledge_author","knowledge_reader"]},{"token":"dev-security-token-replace-me-003","subject":"user:security","tenantId":"tenant-alpha","actorType":"human","displayName":"Dev Security Officer","roles":["security_officer"]}]

# For production, switch to OIDC and supply:
# PCI_IDENTITY_MODE=oidc
# PCI_OIDC_ISSUER=https://idp.example.com
# PCI_OIDC_AUDIENCE=pci-kernel
#   NOTE: the OIDC adapter is a declared seam and is NOT implemented in WP-0001. It throws
#   rather than authenticating. See src/adapters/identity/oidc-identity-provider.ts.
